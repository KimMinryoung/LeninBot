#!/usr/bin/env bash
# svc — LeninBot unified service management
#
# Usage:
#   svc deploy [--api|--telegram|--frontend|--all] [--restart] [--force]
#       Pull code, install deps if changed, restart services, notify via Telegram.
#       Called by Telegram /deploy command. Default: --all, which diffs the
#       last deployed commit against origin and restarts only the enabled
#       long-running units whose code changed (scripts/affected_services.py;
#       docs-only changes restart nothing, unattributable changes restart all),
#       after checking the api/telegram restart guards, in dependency order
#       (llm-proxy, web-gateway, embedding, api, a2a-api, email-api,
#       novel-writer, roleplay, worker, browser, telegram last). The frontend
#       repository deploys itself only when its revision changed.
#       --restart restarts every backend unit even without a change (not the
#       frontend unless --frontend); a --restart of the commit and target
#       deployed less than DEPLOY_RESTART_COOLDOWN seconds ago is skipped
#       unless --force.
#
#   svc boot
#       Start all services in dependency order with health checks. For server reboot.
#
#   svc kill <service...>
#       Force-stop immediately (SIGKILL). For stopping runaway jobs.
#
#   svc restart <service...>
#       Force-kill then start. For stopping runaway jobs and restarting.
#
#   svc status
#       Show status of all services and timers.
#
# Services (boot/kill/restart/status): neo4j embedding api telegram browser frontend
# Timers:   experience
# deploy --all also covers: llm-proxy web-gateway a2a-api email-api
#           novel-writer roleplay worker
# Special:  all

set -euo pipefail

# Resolve DEPLOY_DIR from the script's REAL location (scripts/ lives inside
# it). readlink -f matters: /home/grass/bin/svc is a symlink, and dirname "$0"
# alone resolved DEPLOY_DIR to /home/grass — .env never loaded, FRONTEND_DIR
# pointed at a nonexistent path, and frontend deploys silently no-oped.
DEPLOY_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# Load .env
if [[ -f "$DEPLOY_DIR/.env" ]]; then
    set -a
    source "$DEPLOY_DIR/.env"
    set +a
fi

# Defaults (overridden by .env if set)
FRONTEND_DIR="${FRONTEND_DIR:-$DEPLOY_DIR/../frontend}"
BRANCH="${GIT_BRANCH:-main}"
VENV="$DEPLOY_DIR/venv"
LOG="${DEPLOY_LOG:-/tmp/leninbot-deploy.log}"
DEPLOY_META="${DEPLOY_META:-/tmp/leninbot-deploy-meta.json}"
LOCK_FILE="${DEPLOY_LOCK:-/tmp/leninbot-deploy.lock}"
# "<commit> <target> <epoch>" of the last deploy that reached the restart
# step. A restart-only deploy of the same commit and target inside the
# cooldown is skipped; the flock above only catches overlapping runs.
LAST_DEPLOY_FILE="${DEPLOY_LAST:-/tmp/leninbot-deploy-last}"
# Backend commit the long-running services were last restarted onto by a
# `deploy --all`. The next deploy diffs against it (scripts/affected_services.py)
# so a manual `git pull` before deploying is still attributed correctly. Kept
# outside /tmp so a reboot does not force a full restart. Missing or invalid
# means unknown, which restarts every service.
DEPLOYED_FILE="${DEPLOY_DEPLOYED:-$HOME/.local/state/leninbot/deployed-commit}"
RESTART_COOLDOWN="${DEPLOY_RESTART_COOLDOWN:-600}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Ordered by dependency
ALL_SERVICES=(neo4j embedding api telegram browser frontend)
ALL_TIMERS=(experience)

log()  { echo -e "${GREEN}[svc]${NC} $*"; }
warn() { echo -e "${YELLOW}[svc]${NC} $*"; }
err()  { echo -e "${RED}[svc]${NC} $*" >&2; }

# ── systemctl wrapper (handles root vs sudo) ─────────────────────
_run_systemctl() {
    if [ "$(id -u)" -eq 0 ]; then
        /usr/bin/systemctl "$@"
    else
        sudo /usr/bin/systemctl "$@"
    fi
}

# ── Unit name mapping ────────────────────────────────────────────
to_unit() {
    local name="$1"
    case "$name" in
        frontend) echo "docker:leninbot-frontend" ;;
        experience|razvedchik) echo "leninbot-${name}.timer" ;;
        novel-writer) echo "novel-writer-api.service" ;;
        *) echo "leninbot-${name}.service" ;;
    esac
}

resolve_names() {
    local -a result=()
    for name in "$@"; do
        if [[ "$name" == "all" ]]; then
            result+=("${ALL_SERVICES[@]}" "${ALL_TIMERS[@]}")
        else
            result+=("$name")
        fi
    done
    echo "${result[@]}"
}

# ── Service primitives ───────────────────────────────────────────
do_start() {
    local name="$1"
    local unit
    unit=$(to_unit "$name")
    if [[ "$unit" == docker:* ]]; then
        local container="${unit#docker:}"
        if docker ps --format '{{.Names}}' | grep -qx "$container"; then
            log "$name: already running"
        else
            log "$name: starting container..."
            docker start "$container"
        fi
    else
        log "$name: starting $unit..."
        _run_systemctl start "$unit"
    fi
}

do_stop() {
    local name="$1" force="${2:-no}"
    local unit
    unit=$(to_unit "$name")
    if [[ "$unit" == docker:* ]]; then
        local container="${unit#docker:}"
        if [[ "$force" == "yes" ]]; then
            log "$name: killing container..."
            docker kill "$container" 2>/dev/null || true
        else
            log "$name: stopping container..."
            docker stop "$container" 2>/dev/null || true
        fi
    else
        if [[ "$force" == "yes" ]]; then
            log "$name: killing $unit..."
            # grass's sudoers rule allows stop but not kill, and this failure
            # used to be discarded: `svc restart` then "started" a unit that
            # was still running the old code. Fall back to stop, loudly.
            if ! _run_systemctl kill -s SIGKILL "$unit" 2>/dev/null; then
                warn "$name: kill not permitted or unit inactive; stopping $unit instead"
                _run_systemctl stop "$unit" || { err "$name: could not stop $unit"; exit 1; }
            fi
        else
            log "$name: stopping $unit..."
            _run_systemctl stop "$unit" 2>/dev/null || true
        fi
    fi
}

do_graceful_restart() {
    local name="$1"
    local unit
    unit=$(to_unit "$name")
    if [[ "$unit" == docker:* ]]; then
        local container="${unit#docker:}"
        log "$name: restarting container..."
        docker restart "$container"
    else
        if [[ "$name" == "telegram" || "$name" == "api" ]]; then
            log "$name: checking restart guard..."
            if ! "$VENV/bin/python" "$DEPLOY_DIR/scripts/restart_guard.py" "$name"; then
                err "$name: restart refused by guard. Re-run explicit restart with --force only if active work can be lost."
                exit 2
            fi
        fi
        local before after
        before=$(systemctl show "$unit" -p MainPID --value 2>/dev/null || echo 0)
        log "$name: restarting $unit..."
        _run_systemctl restart "$unit"
        after=$(systemctl show "$unit" -p MainPID --value 2>/dev/null || echo 0)
        if ! systemctl is-active --quiet "$unit"; then
            warn "$name: $unit is not active after restart"
        elif [[ "$before" != "0" && "$before" == "$after" ]]; then
            warn "$name: $unit MainPID unchanged ($after); restart may not have happened"
        fi
    fi
}

# Long-running units that import repository code but are not part of
# ALL_SERVICES. `deploy --all` restarts the enabled ones so none keeps running
# old code: after a module move, a stale process fails at its next
# function-level import of the old path.
DEPLOY_EXTRA_BEFORE=(llm-proxy web-gateway)          # others call through these
DEPLOY_EXTRA_AFTER_API=(a2a-api email-api novel-writer roleplay worker)

_restart_if_enabled() {
    local name="$1" unit
    unit=$(to_unit "$name")
    if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
        do_graceful_restart "$name"
        RESTARTED="${RESTARTED:+$RESTARTED+}$name"
    fi
}

# Succeeds when a package in the venv was installed or upgraded after the
# unit's process started. pip upgrades often run outside a deploy, and such a
# process keeps the old code — the embedding server kept Brotli 1.2.0 after
# the 1.2.1 security upgrade.
_venv_changed_since_start() {
    local unit started
    unit=$(to_unit "$1")
    started=$(systemctl show "$unit" -p ExecMainStartTimestamp --value 2>/dev/null)
    [[ -n "$started" ]] || return 1
    started=$(date -d "$started" +%s 2>/dev/null) || return 1
    [[ -n "$(find "$VENV"/lib/python3*/site-packages -maxdepth 1 -name '*.dist-info' \
        -newermt "@$started" -print -quit 2>/dev/null)" ]]
}

wait_healthy() {
    local name="$1" check="$2" max_wait="${3:-30}"
    local elapsed=0
    while (( elapsed < max_wait )); do
        if eval "$check" &>/dev/null; then
            log "$name: healthy"
            return 0
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    warn "$name: not healthy after ${max_wait}s (continuing anyway)"
    return 1
}

# ── Telegram notification ────────────────────────────────────────
_notify_telegram() {
    local msg="$1"
    source "$DEPLOY_DIR/.env" 2>/dev/null || true
    if [[ -n "${TELEGRAM_BOT_TOKEN:-}" && -n "${ALLOWED_USER_IDS:-}" ]]; then
        # Single-owner: send to first (only) ID, no broadcast
        local uid
        uid=$(echo "$ALLOWED_USER_IDS" | cut -d',' -f1 | tr -d ' ')
        if [[ -n "$uid" ]]; then
            curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
                -d chat_id="$uid" -d text="$msg" -d parse_mode="Markdown" > /dev/null 2>&1 || true
        fi
    fi
}

# ── Git fetch with retry ────────────────────────────────────────
_git_fetch_with_retry() {
    local max_attempts=4 attempt=1
    while (( attempt <= max_attempts )); do
        if git fetch --prune origin; then
            return 0
        fi
        warn "git fetch failed (attempt $attempt/$max_attempts) — retrying"
        git remote prune origin || true
        git gc --prune=now --quiet || true
        sleep $((attempt * 2))
        attempt=$((attempt + 1))
    done
    return 1
}

# ── Frontend deploy ──────────────────────────────────────────────
# The frontend repository owns its deploy (tests, build, labels, the container
# user and data mount). An ad hoc `docker run` here used to start the container
# as root, which then wrote root-owned 0600 files into the shared data dir.
_deploy_frontend() {
    local force_restart="${1:-0}"
    local args=()
    [[ "$force_restart" -eq 1 ]] && args+=(--restart)
    "$FRONTEND_DIR/scripts/deploy" "${args[@]}"
    log "frontend: deploy finished"
    cd "$DEPLOY_DIR"
}

# Succeeds when the last deploy of this commit covered target $2 (an "all"
# deploy covers every target) less than RESTART_COOLDOWN seconds ago.
_recently_deployed() {
    local commit="$1" target="$2" last_commit last_target last_at
    [[ -r "$LAST_DEPLOY_FILE" ]] || return 1
    read -r last_commit last_target last_at < "$LAST_DEPLOY_FILE" || return 1
    [[ "$last_commit" == "$commit" ]] || return 1
    [[ "$last_target" == "all" || "$last_target" == "$target" ]] || return 1
    [[ "$last_at" =~ ^[0-9]+$ ]] || return 1
    (( $(date +%s) - last_at < RESTART_COOLDOWN ))
}

# ════════════════════════════════════════════════════════════════
# Commands
# ════════════════════════════════════════════════════════════════

cmd_deploy() {
    local FORCE_RESTART=0
    local FORCE=0
    local SERVICE="all"

    for arg in "$@"; do
        case "$arg" in
            --restart|-r) FORCE_RESTART=1 ;;
            --force)      FORCE=1 ;;
            --telegram)   SERVICE="telegram" ;;
            --api)        SERVICE="api" ;;
            --frontend)   SERVICE="frontend" ;;
            --all)        SERVICE="all" ;;
            --help|-h)
                echo "Usage: svc deploy [--api|--telegram|--frontend|--all] [--restart] [--force]"
                echo "  --restart, -r   Restart every backend service even without a change"
                echo "                  (the frontend only together with --frontend)."
                echo "  --force         With --restart, ignore the ${RESTART_COOLDOWN}s cooldown after"
                echo "                  a deploy of the same commit and target."
                echo "  --telegram      Restart leninbot-telegram only."
                echo "  --api           Restart leninbot-api only."
                echo "  --frontend      Rebuild and restart frontend container only."
                echo "  --all           Restart the enabled long-running services whose code"
                echo "                  changed since the last deploy (default)."
                exit 0
                ;;
            *)
                err "Unknown option: $arg"
                err "Usage: svc deploy [--api|--telegram|--frontend|--all] [--restart] [--force]"
                exit 2
                ;;
        esac
    done

    # Concurrency lock
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        warn "Another deploy is already running. Skipping."
        _notify_telegram "⚠️ *Deploy 스킵*: 이미 다른 deploy가 진행 중입니다."
        exit 0
    fi

    # Error trap — notify on failure
    _on_error() {
        local exit_code=$? failed_line=$1
        local error_context
        error_context=$(tail -5 "$LOG" 2>/dev/null | head -4)
        err "Deploy failed (line $failed_line, exit $exit_code)"
        rm -f "$LAST_DEPLOY_FILE"  # a failed deploy must not block its retry
        rm -f "$DEPLOYED_FILE"     # services may be mixed; next deploy restarts all
        _notify_telegram "❌ *Deploy 실패* (exit $exit_code)
단계: line $failed_line
\`\`\`
$error_context
\`\`\`"
        cat > "$DEPLOY_META" <<METAEOF
{
  "timestamp": "$(date -Iseconds)",
  "status": "failed",
  "exit_code": $exit_code,
  "failed_line": $failed_line,
  "error": $(echo "$error_context" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null || echo '""')
}
METAEOF
        exit $exit_code
    }
    trap '_on_error $LINENO' ERR
    set -eE

    # Tee output to log
    exec > >(tee "$LOG") 2>&1

    cd "$DEPLOY_DIR"
    log "=== Deploy start (target: $SERVICE) ==="

    local LOCAL="" REMOTE="" DID_PULL=0 CHANGES="" RESTARTED=""

    # ── Frontend-only mode: skip backend steps ──
    local DEPLOY_COMMIT="" RESTART_EMBEDDING=0
    # Restart plan for --all: FULL=1 restarts every unit; otherwise only the
    # names in AFFECTED (space-padded list) restart.
    local FULL=0 AFFECTED=" " BASE="" CHANGED_FILES=""
    if [[ "$SERVICE" == "frontend" ]]; then
        CHANGES="(frontend-only deploy)"
        DEPLOY_COMMIT=$(git -C "$FRONTEND_DIR" rev-parse HEAD 2>/dev/null || echo unknown)
        if [[ "$FORCE" -eq 0 ]] && _recently_deployed "$DEPLOY_COMMIT" frontend; then
            warn "frontend ${DEPLOY_COMMIT:0:8} was deployed less than ${RESTART_COOLDOWN}s ago. Skipping (use --force to redeploy)."
            exit 0
        fi
    else
        # 1. Git pull
        _git_fetch_with_retry
        LOCAL=$(git rev-parse HEAD)
        REMOTE=$(git rev-parse "origin/$BRANCH")

        # Commit the running services were last deployed onto (see DEPLOYED_FILE).
        local DEPLOYED=""
        if [[ -r "$DEPLOYED_FILE" ]]; then
            DEPLOYED=$(tr -d '[:space:]' < "$DEPLOYED_FILE")
            git cat-file -e "${DEPLOYED}^{commit}" 2>/dev/null || DEPLOYED=""
        fi

        if [[ "$LOCAL" == "$REMOTE" ]]; then
            if [[ "$FORCE_RESTART" -eq 1 ]]; then
                if [[ "$FORCE" -eq 0 ]] && _recently_deployed "$LOCAL" "$SERVICE"; then
                    warn "${LOCAL:0:8} [$SERVICE] was deployed less than ${RESTART_COOLDOWN}s ago. Skipping restart (use --force to restart again)."
                    exit 0
                fi
                log "Already up to date, but --restart requested."
                CHANGES="(no code change: restart only)"
            elif [[ "$SERVICE" != "all" || "$DEPLOYED" == "$LOCAL" ]]; then
                log "Already up to date. No backend restart needed."
                if [[ "$SERVICE" == "all" && -d "$FRONTEND_DIR" ]]; then
                    _deploy_frontend 0
                fi
                exit 0
            else
                # Code was pulled outside deploy (e.g. a manual git pull):
                # the services still run ${DEPLOYED:-an unknown commit}.
                local shown="${DEPLOYED:0:8}"
                log "Code already at ${LOCAL:0:8}; services were last deployed at ${shown:-an unknown commit}."
                CHANGES=$([[ -n "$DEPLOYED" ]] && git log "$DEPLOYED..$LOCAL" --oneline || echo "(last deployed commit unknown)")
            fi
        else
            CHANGES=$(git log "$LOCAL..$REMOTE" --oneline)
            log "Changes detected: $LOCAL → $REMOTE"
            echo "$CHANGES"
            git pull origin "$BRANCH"
            DID_PULL=1
        fi

        DEPLOY_COMMIT="$REMOTE"

        # Diff base for dependency/unit checks and the restart plan: the last
        # deployed commit, else the pre-pull HEAD.
        if [[ -n "$DEPLOYED" ]]; then
            BASE="$DEPLOYED"
        elif [[ "$DID_PULL" -eq 1 ]]; then
            BASE="$LOCAL"
        fi
        if [[ -n "$BASE" ]]; then
            CHANGED_FILES=$(git diff --name-only "$BASE" "$REMOTE")
        fi

        # The embedding server reloads its model on restart, so it restarts
        # only when its code or the dependencies changed, or when pip changed
        # the venv after it started.
        if echo "$CHANGED_FILES" | grep -qE "requirements|services/embedding_server\.py"; then
            RESTART_EMBEDDING=1
        elif _venv_changed_since_start embedding; then
            log "embedding: venv packages changed after it started"
            RESTART_EMBEDDING=1
        fi

        # 2. Dependencies
        if echo "$CHANGED_FILES" | grep -q "requirements"; then
            log "Requirements changed → pip install"
            source "$VENV/bin/activate"
            pip install -r requirements.txt --quiet
            if pip show playwright > /dev/null 2>&1; then
                log "Ensuring Playwright chromium..."
                playwright install --with-deps chromium 2>/dev/null || true
            fi
        else
            log "No dependency changes"
        fi

        # 3. Deploy metadata
        cat > "$DEPLOY_META" <<METAEOF
{
  "timestamp": "$(date -Iseconds)",
  "status": "success",
  "prev_commit": "${BASE:-$LOCAL}",
  "new_commit": "$REMOTE",
  "changes": $(echo "$CHANGES" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read().strip()))'),
  "deps_updated": $(echo "$CHANGED_FILES" | grep -q "requirements" && echo "true" || echo "false")
}
METAEOF

        # 4. daemon-reload if systemd units changed
        if echo "$CHANGED_FILES" | grep -q "^systemd/"; then
            log "systemd unit files changed → daemon-reload"
            _run_systemctl daemon-reload
        fi

        # 5a. Restart plan
        if [[ "$SERVICE" == "all" ]]; then
            if [[ "$FORCE_RESTART" -eq 1 ]]; then
                FULL=1
                log "Restart plan: every service (--restart)"
            elif [[ -z "$BASE" ]]; then
                FULL=1
                log "Restart plan: every service (last deployed commit unknown)"
            else
                local plan
                if ! plan=$("$VENV/bin/python" "$DEPLOY_DIR/scripts/affected_services.py" "$BASE" "$REMOTE"); then
                    warn "affected_services.py failed; restarting every service"
                    plan="ALL"
                fi
                if [[ "$plan" == "ALL" ]]; then
                    FULL=1
                    log "Restart plan: every service (change cannot be attributed)"
                else
                    [[ -n "$plan" ]] && AFFECTED=" $(echo $plan) "
                    if [[ "$AFFECTED" == " " ]]; then
                        log "Restart plan: nothing (no running service affected)"
                    else
                        log "Restart plan:${AFFECTED% }"
                    fi
                fi
            fi
        fi
    fi

    # Whether --all restarts service $1 under the plan above.
    _planned() { [[ "$FULL" -eq 1 || "$AFFECTED" == *" $1 "* ]]; }

    # 5. Restart services
    local SUMMARY
    SUMMARY=$(git log --oneline -1 2>/dev/null || echo "n/a")

    local ANY_RESTART=0
    if [[ "$SERVICE" == "all" ]] && { [[ "$FULL" -eq 1 || "$AFFECTED" != " " || "$RESTART_EMBEDDING" -eq 1 ]]; }; then
        ANY_RESTART=1
    fi

    # Check both guards before restarting anything: the proxy restart below
    # would otherwise cut in-flight LLM calls of a task the telegram guard
    # later protects.
    if [[ "$ANY_RESTART" -eq 1 ]]; then
        local guarded name
        for guarded in api telegram; do
            if ! "$VENV/bin/python" "$DEPLOY_DIR/scripts/restart_guard.py" "$guarded"; then
                err "$guarded: restart refused by guard; nothing restarted. Re-run once active work finishes."
                exit 2
            fi
        done
        for name in "${DEPLOY_EXTRA_BEFORE[@]}"; do
            if _planned "$name"; then _restart_if_enabled "$name"; fi
        done
        if [[ "$RESTART_EMBEDDING" -eq 1 ]] || { [[ "$FULL" -eq 0 ]] && _planned embedding; }; then
            _restart_if_enabled embedding
            wait_healthy embedding "curl -sf http://localhost:8100/health" 60 || true
        fi
    fi

    # Stamp before the restarts: restarting telegram may kill this script
    # (Telegram /deploy), so the end of the function is not always reached.
    echo "$DEPLOY_COMMIT $SERVICE $(date +%s)" > "$LAST_DEPLOY_FILE"
    if [[ "$SERVICE" == "all" ]]; then
        mkdir -p "$(dirname "$DEPLOYED_FILE")"
        echo "$DEPLOY_COMMIT" > "$DEPLOYED_FILE"
    fi

    if [[ "$SERVICE" == "api" ]] || { [[ "$SERVICE" == "all" ]] && _planned api; }; then
        do_graceful_restart api
        RESTARTED="${RESTARTED:+$RESTARTED+}api"
    fi

    if [[ "$SERVICE" == "all" ]]; then
        for name in "${DEPLOY_EXTRA_AFTER_API[@]}"; do
            if _planned "$name"; then _restart_if_enabled "$name"; fi
        done
    fi

    # 6. Notify BEFORE restarting telegram (since telegram restart kills the bot)
    local PENDING=""
    if [[ "$SERVICE" == "telegram" ]] || { [[ "$SERVICE" == "all" ]] && _planned telegram; }; then
        PENDING="+telegram"
    fi
    _notify_telegram "✅ *Deploy 완료* [$SERVICE] 재시작: ${RESTARTED:-없음}${PENDING}
\`$SUMMARY\`
변경 커밋:
\`\`\`
$CHANGES
\`\`\`"

    # 7. Browser worker
    # Read-only queries run without sudo: sudoers allows only
    # "is-active leninbot-*", so "sudo systemctl is-active --quiet ..." asked
    # for a password, failed, and the browser was silently never restarted.
    if [[ "$SERVICE" == "all" ]] && _planned browser && systemctl is-active --quiet leninbot-browser 2>/dev/null; then
        do_graceful_restart browser
        RESTARTED="${RESTARTED:+$RESTARTED+}browser"
    fi

    # 8. Telegram last (restarts the bot process — may kill this script)
    if [[ "$SERVICE" == "telegram" ]] || { [[ "$SERVICE" == "all" ]] && _planned telegram; }; then
        do_graceful_restart telegram
        RESTARTED="${RESTARTED:+$RESTARTED+}telegram"
    fi

    # 9. Frontend. Its own deploy skips an already deployed revision; --restart
    # is forwarded only when the frontend was the explicit target.
    if [[ "$SERVICE" == "all" || "$SERVICE" == "frontend" ]]; then
        if [[ -d "$FRONTEND_DIR" ]]; then
            if [[ "$SERVICE" == "frontend" ]]; then
                _deploy_frontend "$FORCE_RESTART"
            else
                _deploy_frontend 0
            fi
            RESTARTED="${RESTARTED:+$RESTARTED+}frontend"
        fi
    fi

    log "=== Deploy complete [$RESTARTED]: $SUMMARY ==="
}

cmd_boot() {
    log "=== LeninBot full boot sequence ==="
    _run_systemctl daemon-reload

    # 1. Infrastructure
    do_start neo4j
    wait_healthy neo4j "docker exec leninbot-neo4j wget -qO- http://localhost:7474" 60
    wait_healthy redis "docker exec leninbot-redis redis-cli ping" 30

    # 2. Embedding (needed by api and telegram)
    do_start embedding
    wait_healthy embedding "curl -sf http://localhost:8100/health" 60

    # 3. LLM fallback (independent)
    do_start llama

    # 4. API + Telegram (both depend on neo4j + embedding)
    do_start api
    do_start telegram
    wait_healthy api "curl -sf http://localhost:8000/docs" 15

    # 5. Browser worker (depends on telegram)
    do_start browser

    # 6. Frontend
    do_start frontend
    wait_healthy frontend "curl -sf http://localhost:3000" 15

    # 7. Timers
    for t in "${ALL_TIMERS[@]}"; do
        do_start "$t"
    done

    echo
    log "=== Boot complete ==="
    cmd_status
}

cmd_kill() {
    if [[ $# -eq 0 ]]; then
        err "Usage: svc kill <service...>"
        exit 1
    fi
    local names=($(resolve_names "$@"))
    local i
    for (( i=${#names[@]}-1; i>=0; i-- )); do
        do_stop "${names[$i]}" yes
    done
}

cmd_restart() {
    if [[ $# -eq 0 ]]; then
        err "Usage: svc restart <service...>"
        exit 1
    fi
    local names=($(resolve_names "$@"))

    # Kill in reverse order
    local i
    for (( i=${#names[@]}-1; i>=0; i-- )); do
        do_stop "${names[$i]}" yes
    done
    sleep 1

    # Start in forward order
    for name in "${names[@]}"; do
        do_start "$name"
    done
    echo
    cmd_status
}

cmd_status() {
    echo -e "${GREEN}=== Services ===${NC}"
    for name in "${ALL_SERVICES[@]}"; do
        local unit state
        unit=$(to_unit "$name")
        if [[ "$unit" == docker:* ]]; then
            local container="${unit#docker:}"
            state=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo "not found")
            if [[ "$state" == "running" ]]; then
                echo -e "  ${GREEN}●${NC} $name ($container): $state"
            else
                echo -e "  ${RED}●${NC} $name ($container): $state"
            fi
        else
            state=$(systemctl is-active "$unit" 2>/dev/null || true)
            if [[ "$state" == "active" || "$state" == "activating" ]]; then
                echo -e "  ${GREEN}●${NC} $name: $state"
            else
                echo -e "  ${RED}●${NC} $name: ${state:-dead}"
            fi
        fi
    done

    echo -e "\n${GREEN}=== Timers ===${NC}"
    for name in "${ALL_TIMERS[@]}"; do
        local unit state
        unit=$(to_unit "$name")
        state=$(systemctl is-active "$unit" 2>/dev/null || true)
        if [[ "$state" == "active" ]]; then
            echo -e "  ${GREEN}●${NC} $name: $state"
        else
            echo -e "  ${RED}●${NC} $name: ${state:-dead}"
        fi
    done
}

# ════════════════════════════════════════════════════════════════
# Entry point
# ════════════════════════════════════════════════════════════════

case "${1:-}" in
    deploy)  shift; cmd_deploy "$@" ;;
    boot)    cmd_boot ;;
    kill)    shift; cmd_kill "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    status)  cmd_status ;;
    *)
        cat <<'USAGE'
Usage: svc <command> [args...]

Commands:
  deploy [--api|--telegram|--frontend|--all] [--restart]
      Pull code, install deps, restart services, notify via Telegram.
      Default: --all. Use --restart to force restart even without changes.

  boot
      Start all services in dependency order with health checks.
      Use after server reboot.

  kill <service...>
      Force-stop immediately (SIGKILL). For runaway jobs.

  restart <service...>
      Force-kill then start. For runaway jobs that need restarting.

  status
      Show status of all services and timers.

Services: neo4j embedding api telegram browser frontend
Timers:   experience
Special:  all
USAGE
        exit 1
        ;;
esac
