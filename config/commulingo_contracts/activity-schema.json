{
  "type": "array",
  "minItems": 1,
  "maxItems": 30,
  "description": "Documented activities. Exactly one primary; function, affiliation and period refer to the same career. Never infer affiliation from citizenship.",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "functionId",
      "affiliationId",
      "affiliationStatus",
      "relation",
      "primary",
      "evidence"
    ],
    "properties": {
      "functionId": {
        "type": "string"
      },
      "affiliationId": {
        "type": [
          "string",
          "null"
        ]
      },
      "affiliationStatus": {
        "type": "string",
        "enum": [
          "confirmed",
          "independent",
          "unresolved"
        ]
      },
      "relation": {
        "type": "string",
        "enum": [
          "service",
          "membership",
          "employment",
          "independent",
          "unresolved"
        ]
      },
      "officeId": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional commulingo_offices id (Soviet institution line) this activity was carried out in. Only with the state-soviet, soviet-party or comintern affiliation."
      },
      "title": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "ko",
          "en"
        ],
        "properties": {
          "ko": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "description": "Optional name of the post held, in both languages (e.g. {\"ko\":\"바이에른 총리 겸 외무장관\",\"en\":\"Minister-President and Foreign Minister of Bavaria\"}). Only with relation service or employment. Use officeId instead when the post is a commulingo_offices line."
      },
      "startYear": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -3000,
        "maximum": 2200
      },
      "endYear": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": -3000,
        "maximum": 2200
      },
      "primary": {
        "type": "boolean"
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "locator",
            "claim",
            "excerpt"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "excerpt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "description": "At least one cited excerpt. Only an existing activity with basis 'legacy-classification' may have none."
      },
      "basis": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "legacy-classification",
          null
        ],
        "description": "Set only by migration 215 for activities carried over from the retired role classification without evidence. Never add one; keep an existing one unchanged or replace it with a documented activity."
      }
    }
  }
}
