# leninbot environment template
#
# Copy to .env for local development:
#   cp .env.example .env
# Then fill in each value.
#
# In production, Tier A (secrets) live in /etc/credstore.encrypted/ and are
# loaded via systemd LoadCredentialEncrypted — they do NOT need to be in .env
# for services managed by systemd. .env is for the dev loop only.
#
# See scripts/migrate_secrets_to_credstore.py for the migration flow.
# See secrets_loader.py for the credstore→.env fallback resolution order.

# ════════════════════════════════════════════════════════════════════════════
# Tier A — SECRETS (production: systemd credentials, dev: .env)
# ════════════════════════════════════════════════════════════════════════════

# LLM providers
ANTHROPIC_API_KEY=
# Optional: organization cost report only; production keeps these in credstore.
ANTHROPIC_ADMIN_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
DEEPSEEK_API_KEY=
DEEPL_API_KEY=
OPENROUTER_API_KEY=
ALIBABA_API_KEY=
HF_TOKEN=

# Web tooling
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
REPLICATE_API_TOKEN=
RESEND_API_KEY=

# Leninbot-internal
ADMIN_API_KEY=
AI_DIARY_API_KEY=
WEBCHAT_PROXY_SECRET=

# External platforms
GITHUB_TOKEN=
MOLTBOOK_API_KEY=
GRAFFITI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Infra
DB_PASSWORD=
NEO4J_PASSWORD=
EMAIL_IMAP_PASSWORD=
EMAIL_SMTP_PASSWORD=
R2_CF_API_TOKEN=

# ════════════════════════════════════════════════════════════════════════════
# Tier B — non-secret config (safe to leave in .env in all environments)
# ════════════════════════════════════════════════════════════════════════════

# Bot identity / access control
ALLOWED_USER_IDS=
TELEGRAM_CHAT_ID=
MY_DOMAIN=
RAZVEDCHIK_TELEGRAM_NOTIFY=0
TELEGRAM_BROADCAST_MOLTBOOK_ENABLED=true
TELEGRAM_BROADCAST_DIARY_ENABLED=false
TELEGRAM_BROADCAST_AUTONOMOUS_PROJECT_IDS=2

# Web search provider order and process-local failure cooldown. Providers
# without a configured key are skipped through the same fallback path.
WEB_SEARCH_PROVIDERS=tavily,brave
WEB_SEARCH_PROVIDER_COOLDOWN_SECONDS=300

# Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_POOL_MODE=transaction
DB_SSL=require
VECTOR_DB_TABLE_NAME=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Redis
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (public-ish identifiers)
R2_CF_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email bridge
EMAIL_BRIDGE_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_FROM_EMAIL=
EMAIL_SMTP_FROM_NAME=Cyber-Lenin
EMAIL_POLL_INTERVAL_SECONDS=120
EMAIL_DEFAULT_APPROVER_USER_ID=

# Local/remote LLM endpoints (self-hosted)
DEEPSEEK_BASE_URL=https://api.deepseek.com
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
MOON_LLM_BASE_URL=
MOON_LLM_MODEL=
EMBEDDING_URL=http://127.0.0.1:8100
EMBEDDING_PORT=8100
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_OFFLINE=1
EMBEDDING_PRELOAD_RERANKER=0
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto

# External / misc
AI_DIARY_API_URL=
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
FRONTEND_DIR=
WEBCHAT_RATE_LIMIT=20
WEBCHAT_RATE_WINDOW_SECONDS=300
WEBCHAT_GLOBAL_ACTIVE_LIMIT=8
WEBCHAT_CORS_ORIGINS=https://cyber-lenin.com,http://localhost:3000
A2A_ENABLED=true
TASK_RATE_LIMIT_REQUEUE_SECONDS=300
X402_DEMO_QUOTE_USDC=0.05
X402_MAX_USDC_PER_CALL=0.05

# Wallet public addresses (not secrets — private keys live in credstore)
WALLET_ETH_ADDRESS=
WALLET_SOL_ADDRESS=
WALLET_TRX_ADDRESS=

# ════════════════════════════════════════════════════════════════════════════
# Tier C (deploy state / paths) — intentionally removed
# ════════════════════════════════════════════════════════════════════════════
# PROJECT_ROOT, VENV_PYTHON, VENV_PIP, GIT_BRANCH, DEPLOY_LOCK/LOG/META
# are now derived in code (Path(__file__)...). Do not re-add them to .env.

# ── Knowledge graph hub (2026-09-03) ──────────────────────────────────
# Inject facts for entities named in a message/task (alias match only, no
# embedding). Off until the CommuLingo mirror has run.
KG_ENTITY_GATED_RECALL=0
# LLM fact extraction from published documents (registry site
# kg_document_extraction, gemini-3.5-flash-lite). Off until spend is approved;
# the deterministic Document/Reference layer runs regardless.
KG_DOC_EXTRACT_LLM=0
# Name-embedding nearest-neighbour step in entity resolution (one embedding
# per unresolved name). Off until false-merge rate is measured.
KG_RESOLVE_EMBEDDING_NN=0
