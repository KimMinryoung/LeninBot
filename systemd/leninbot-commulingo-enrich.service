[Unit]
Description=LeninBot CommuLingo existing-person enricher
Wants=network-online.target
# Ordering only: when the daily batch queues all four lanes, they run one at a
# time in new -> enrich -> terms -> maintainer order. No effect when started alone.
After=network-online.target leninbot-commulingo-new.service

[Service]
Type=oneshot
User=grass
WorkingDirectory=/home/grass/leninbot
EnvironmentFile=/home/grass/leninbot/.env
Environment=PYTHONUNBUFFERED=1
Environment=COMMULINGO_SUGGESTED_BY=commulingo-maintainer-enrich
LoadCredentialEncrypted=deepseek_api_key:/etc/credstore.encrypted/deepseek_api_key.cred
LoadCredentialEncrypted=db_password:/etc/credstore.encrypted/db_password.cred
LoadCredentialEncrypted=tavily_api_key:/etc/credstore.encrypted/tavily_api_key.cred
Environment=COMMULINGO_DAILY_CAP_USD=2.5
ExecCondition=/home/grass/leninbot/venv/bin/python /home/grass/leninbot/scripts/commulingo_budget_guard.py
ExecStart=/home/grass/leninbot/venv/bin/python /home/grass/leninbot/scripts/commulingo_people_parallel.py --mode enrich
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
