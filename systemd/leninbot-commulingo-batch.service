[Unit]
Description=LeninBot CommuLingo event and link batch
# People and terms are owned by the durable pipeline. Events and links retain
# their daily batch and reserve against the same PostgreSQL budget ledger.
Wants=leninbot-commulingo-events.service
Wants=leninbot-commulingo-links.service
After=leninbot-commulingo-events.service
After=leninbot-commulingo-links.service

[Service]
Type=oneshot
ExecStart=/bin/true
