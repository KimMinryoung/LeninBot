[Unit]
Description=LeninBot CommuLingo curator batch (runs the lanes sequentially)
# Pulls in the lanes; their mutual After= ordering runs them one at a time
# (gap -> enrich -> events -> links). Wants, not Requires: one lane failing must not
# cancel the rest. Each lane keeps its own budget-guard ExecCondition, so a
# mid-batch cap hit skips the remaining lanes' work.
#
# The gap queue comes first because it holds what the event pages decided they
# needed: a person the narrative leans on and the site does not have. The old
# new/enrich/terms lanes picked their own subject instead, and while the queue
# has a backlog that is the wrong thing to spend the window on. Their units are
# still installed and can be wanted here again when the queue runs dry.
Wants=leninbot-commulingo-gap.service
Wants=leninbot-commulingo-enrich.service
Wants=leninbot-commulingo-events.service
Wants=leninbot-commulingo-links.service
After=leninbot-commulingo-gap.service
After=leninbot-commulingo-enrich.service
After=leninbot-commulingo-events.service
After=leninbot-commulingo-links.service

[Service]
Type=oneshot
ExecStart=/bin/true
