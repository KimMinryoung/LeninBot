[Unit]
Description=LeninBot daily news → knowledge graph (search, select, extract, structured write)
After=network.target leninbot-neo4j.service leninbot-llm-proxy.service leninbot-web-gateway.service
Wants=leninbot-llm-proxy.service leninbot-web-gateway.service
Requires=leninbot-neo4j.service

[Service]
Type=oneshot
User=grass
WorkingDirectory=/home/grass/leninbot
EnvironmentFile=/home/grass/leninbot/.env
LoadCredentialEncrypted=neo4j_password:/etc/credstore.encrypted/neo4j_password.cred
LoadCredentialEncrypted=db_password:/etc/credstore.encrypted/db_password.cred
LoadCredentialEncrypted=telegram_bot_token:/etc/credstore.encrypted/telegram_bot_token.cred
# ≤8 searches, ≤12 article fetches, ≤7 LLM calls per run (jobs/news_kg.py caps).
ExecStart=/home/grass/leninbot/venv/bin/python -m jobs.news_kg --notify-on-error
TimeoutStartSec=1800
