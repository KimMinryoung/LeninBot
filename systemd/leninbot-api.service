[Unit]
Description=LeninBot API (FastAPI + Uvicorn)
After=network.target leninbot-neo4j.service leninbot-llm-proxy.service
Wants=leninbot-llm-proxy.service
# Wants, not Requires: a failed DB-stack start must not cancel this job for
# good (2026-09-23 outage). DB access is lazy and recovers with the stack.
Wants=leninbot-neo4j.service

[Service]
User=grass
WorkingDirectory=/home/grass/leninbot
EnvironmentFile=/home/grass/leninbot/.env
ExecStart=/home/grass/leninbot/venv/bin/python -m uvicorn services.api:app --host 172.17.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
