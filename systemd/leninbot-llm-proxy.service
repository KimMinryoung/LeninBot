[Unit]
Description=LeninBot LLM Proxy (key-injection passthrough; sole holder of provider API keys)
Wants=network-online.target
After=network-online.target

[Service]
# A transient, per-boot UID that is NOT grass. systemd grants the decrypted
# credentials below to the service user alone, so running as grass made every
# grass process (the lanes, an operator shell, an ad hoc script) a co-holder of
# the provider keys and the proxy a convention rather than a boundary. Under a
# dynamic UID the keys in /run/credentials are readable only by this unit; the
# sole way for anything else to reach a provider is an HTTP call to 127.0.0.1:8110,
# which is audited and budget-gated here. SupplementaryGroups=grass is read-only
# reach the other way (into the group-readable, world-readable source tree under
# /home/grass, 0750), and grants nothing back toward these credentials.
DynamicUser=yes
SupplementaryGroups=grass
WorkingDirectory=/home/grass/leninbot
# .env + db_password: the authoritative policy gate reads today's spend
# from llm_audit_log for the daily budget caps (fail-open on DB errors).
EnvironmentFile=/home/grass/leninbot/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/grass/leninbot/venv/bin/python -m uvicorn llm_proxy.app:app --host 127.0.0.1 --port 8110
ExecStartPost=/home/grass/leninbot/venv/bin/python /home/grass/leninbot/scripts/wait_llm_proxy_ready.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
UMask=0077
# Provider keys live HERE and, now that the unit runs under a dynamic UID,
# are readable by no other local account. The blobs are host-key encrypted
# with name binding, shared with the credstore layout in
# dev_docs/secret_management.md.
LoadCredentialEncrypted=db_password:/etc/credstore.encrypted/db_password.cred
# Audit sink INSERT-only role (dev_docs/llm_gateway.md "감사 싱크"). Enable after
# `manage_secrets.py add AUDIT_DB_PASSWORD` + `schema_migrations.py --only audit-sink-role`;
# a LoadCredentialEncrypted= pointing at a missing file fails the unit at start.
#LoadCredentialEncrypted=audit_db_password:/etc/credstore.encrypted/audit_db_password.cred
LoadCredentialEncrypted=anthropic_api_key:/etc/credstore.encrypted/anthropic_api_key.cred
LoadCredentialEncrypted=deepseek_api_key:/etc/credstore.encrypted/deepseek_api_key.cred
LoadCredentialEncrypted=moonshot_api_key:/etc/credstore.encrypted/moonshot_api_key.cred
LoadCredentialEncrypted=openai_api_key:/etc/credstore.encrypted/openai_api_key.cred
LoadCredentialEncrypted=gemini_api_key:/etc/credstore.encrypted/gemini_api_key.cred
# Optional openai_admin_key / anthropic_admin_key mounts are generated by
# scripts/migrate_secrets_to_credstore.py only when those credentials exist.

[Install]
WantedBy=multi-user.target
