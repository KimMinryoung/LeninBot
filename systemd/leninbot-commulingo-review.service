[Unit]
Description=LeninBot independent CommuLingo person review and owner handoff
Wants=network-online.target leninbot-llm-proxy.service
After=network-online.target leninbot-llm-proxy.service

[Service]
Type=oneshot
User=grass
WorkingDirectory=/home/grass/leninbot
EnvironmentFile=/home/grass/leninbot/.env
Environment=PYTHONUNBUFFERED=1
Environment=COMMULINGO_DAILY_CAP_USD=2.5
LoadCredentialEncrypted=db_password:/etc/credstore.encrypted/db_password.cred
LoadCredentialEncrypted=tavily_api_key:/etc/credstore.encrypted/tavily_api_key.cred
LoadCredentialEncrypted=telegram_bot_token:/etc/credstore.encrypted/telegram_bot_token.cred
# Budget check is inside the worker, after outstanding operator notifications.
ExecStart=/home/grass/leninbot/venv/bin/python /home/grass/leninbot/scripts/commulingo_person_reviewer.py
TimeoutStartSec=650
StandardOutput=journal
StandardError=journal
