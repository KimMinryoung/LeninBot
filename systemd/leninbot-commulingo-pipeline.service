[Unit]
Description=Durable CommuLingo editorial batch
Wants=network-online.target leninbot-llm-proxy.service
After=network-online.target leninbot-llm-proxy.service

[Service]
Type=oneshot
User=grass
WorkingDirectory=/home/grass/leninbot
EnvironmentFile=/home/grass/leninbot/.env
Environment=PYTHONUNBUFFERED=1
LoadCredentialEncrypted=neo4j_password:/etc/credstore.encrypted/neo4j_password.cred
LoadCredentialEncrypted=db_password:/etc/credstore.encrypted/db_password.cred
ExecStart=/home/grass/leninbot/venv/bin/python /home/grass/leninbot/scripts/commulingo_pipeline.py tick
TimeoutStartSec=1950
# 2026-09-19: a runaway source-snapshot merge drove one tick to 9 GB anon-rss
# and stalled the whole host (no swap) before the global OOM killer acted.
# A batch that needs more than this is broken; kill the tick, not the server.
MemoryHigh=2G
MemoryMax=3G
StandardOutput=journal
StandardError=journal
