[Unit]
Description=LeninBot CommuLingo gap-queue worker (people an event page asked for; terms parked 2026-08-29)
Wants=network-online.target leninbot-llm-proxy.service
# Manual-start lane: no timer since the daily batch was retired (2026-09-20).
# The queue is what the event pages decided they needed.
After=network-online.target leninbot-llm-proxy.service

[Service]
Type=oneshot
User=grass
WorkingDirectory=/home/grass/leninbot
EnvironmentFile=/home/grass/leninbot/.env
Environment=PYTHONUNBUFFERED=1
LoadCredentialEncrypted=db_password:/etc/credstore.encrypted/db_password.cred
Environment=COMMULINGO_DAILY_CAP_USD=0
ExecCondition=/home/grass/leninbot/venv/bin/python /home/grass/leninbot/scripts/commulingo_budget_guard.py
# One gap per run. An empty queue exits 0 in seconds and costs nothing.
ExecStart=/home/grass/leninbot/venv/bin/python /home/grass/leninbot/scripts/commulingo_gap_worker.py --kind person --worker 0
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
